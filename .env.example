# Redis (bridge between API tier and orderbook)
REDIS_URL=redis://localhost:6379

# Logging
RUST_LOG=info,exchange=debug

# ── API server ────────────────────────────────────────────
API_BIND=0.0.0.0:8080
JWT_SECRET=change-me-to-32-bytes-of-entropy-in-production
JWT_TTL_HOURS=24
ALLOWED_ORIGINS=http://localhost:3000,https://crypto-exchange-rujul.vercel.app

# ── Orderbook server ──────────────────────────────────────
ORDERBOOK_BIND=127.0.0.1:8081
ORDERBOOK_SNAPSHOT_DIR=./snapshots
ORDERBOOK_SNAPSHOT_INTERVAL_MS=10000
DEMO_BOT=true
DEMO_SYMBOLS=SOL-USDC
DEMO_BOT_SPREAD_BPS=10
DEMO_BOT_LEVEL_STEP_BPS=2
DEMO_BOT_LEVEL_SIZE=0.5
DEMO_BOT_QUOTE_INTERVAL_MS=500
SOL_USDC_STARTING_MID=150

# ── Settler worker ────────────────────────────────────────
SETTLER_RPC_URL=https://api.devnet.solana.com
SETTLER_KEYPAIR_PATH=./keys/settler.json
SETTLER_COMMITMENT=confirmed
SETTLER_MAX_RETRIES=5

# ── Anchor program (filled in after Phase 2 deploy) ───────
EXCHANGE_PROGRAM_ID=
SOL_MINT=So11111111111111111111111111111111111111112
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
